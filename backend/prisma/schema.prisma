generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  email                  String?             @unique
  name                   String
  role                   Role                @default(EMPLOYEE)
  createdAt              DateTime            @default(now())
  teamId                 String?
  avatarUrl              String?
  provider               String?             @default("google")
  phoneNumber            String?
  skills                 String[]            @default([])
  emailVerified          Boolean             @default(false)
  password               String?
  emailVerificationToken String?
  passwordResetExpires   DateTime?
  passwordResetToken     String?
  hourlyRate             Decimal?            @db.Decimal(10, 2)
  maxHours               Int?
  status                 UserStatus          @default(ACTIVE)
  nickname               String?
  notes                  String?
  shiftAssignments       ShiftAssignment[]
  availabilitySlots      AvailabilitySlot[]
  memberships            TeamMembership[]
  swapRequestsMade       SwapRequest[]       @relation("SwapRequester")
  swapRequestsReceived   SwapRequest[]       @relation("SwapTarget")
  team                   Team?               @relation(fields: [teamId], references: [id])
}

model Team {
  id                 String             @id @default(uuid())
  name               String
  createdAt          DateTime          @default(now())
  inviteCode         String             @unique
  shifts             Shift[]
  availabilitySlots  AvailabilitySlot[]
  memberships        TeamMembership[]
  swapRequests       SwapRequest[]
  users              User[]
}

/// Dostępność pracownika: przedział czasowy, w którym może pracować (min. 4h na slot).
model AvailabilitySlot {
  id           String   @id @default(uuid())
  userId       String
  teamId       String
  startDateTime DateTime
  endDateTime   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, startDateTime])
  @@index([teamId, startDateTime])
}

model Shift {
  id           String             @id @default(uuid())
  startTime    DateTime
  endTime      DateTime
  roleName     String
  status       ShiftStatus       @default(DRAFT)
  teamId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  team         Team             @relation(fields: [teamId], references: [id])
  assignments  ShiftAssignment[]

  @@index([teamId, startTime])
}

/// Jedna "pozycja" na zmianie. Jedna zmiana może mieć wiele pozycji (kilku pracowników).
/// Giełda: isUpForGrabs = true — ktoś może przejąć to przypisanie (claim).
model ShiftAssignment {
  id           String   @id @default(uuid())
  shiftId      String
  userId       String?
  isUpForGrabs Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shift              Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  swapRequestsFrom   SwapRequest[] @relation("SwapFromAssignment")
  swapRequestsTo     SwapRequest[] @relation("SwapToAssignment")

  @@index([shiftId])
  @@index([userId])
  @@index([isUpForGrabs])
}

model TeamMembership {
  id          String           @id @default(uuid())
  userId      String
  teamId      String
  status      MembershipStatus @default(PENDING)
  role        Role             @default(EMPLOYEE)
  requestedAt DateTime         @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  team        Team             @relation(fields: [teamId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@unique([userId, teamId])
}

/// Zamiana zmian: pracownik A prosi o zamianę → pracownik B akceptuje → Manager zatwierdza.
model SwapRequest {
  id                String        @id @default(uuid())
  assignmentId      String
  requesterId       String
  targetUserId      String?
  targetAssignmentId String?
  teamId            String
  status            SwapStatus    @default(PENDING_ACCEPT)
  reason            String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  resolvedAt        DateTime?
  resolvedBy        String?
  assignment        ShiftAssignment @relation("SwapFromAssignment", fields: [assignmentId], references: [id], onDelete: Cascade)
  targetAssignment  ShiftAssignment? @relation("SwapToAssignment", fields: [targetAssignmentId], references: [id], onDelete: SetNull)
  requester         User          @relation("SwapRequester", fields: [requesterId], references: [id])
  targetUser        User?         @relation("SwapTarget", fields: [targetUserId], references: [id])
  team              Team          @relation(fields: [teamId], references: [id])

  @@index([teamId, status])
  @@index([requesterId])
  @@index([targetUserId])
}

enum SwapStatus {
  PENDING_ACCEPT
  ACCEPTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}

enum UserStatus {
  ACTIVE
  UNCLAIMED
}
