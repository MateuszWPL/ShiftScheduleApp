generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  email                  String?             @unique
  name                   String
  role                   Role                @default(EMPLOYEE)
  createdAt              DateTime            @default(now())
  teamId                 String?
  avatarUrl              String?
  provider               String?             @default("google")
  phoneNumber            String?
  skills                 String[]            @default([])
  emailVerified          Boolean             @default(false)
  password               String?
  emailVerificationToken String?
  passwordResetExpires   DateTime?
  passwordResetToken     String?
  hourlyRate             Decimal?            @db.Decimal(10, 2)
  maxHours               Int?
  status                 UserStatus          @default(ACTIVE)
  nickname               String?
  notes                  String?
  tokenVersion           Int                 @default(0)
  shiftAssignments       ShiftAssignment[]
  availabilitySlots      AvailabilitySlot[]
  memberships            TeamMembership[]
  notifications          Notification[]
  announcements          Announcement[]      @relation("AnnouncementAuthor")
  announcementReads      AnnouncementRead[]
  employeePositions      EmployeePosition[]
  team                   Team?               @relation(fields: [teamId], references: [id])
  calendarFeed           CalendarFeed?
  googleCalendarToken    GoogleCalendarToken?
}

model Team {
  id                 String             @id @default(uuid())
  name               String
  createdAt          DateTime          @default(now())
  inviteCode         String             @unique
  shifts             Shift[]
  positions          Position[]
  availabilitySlots  AvailabilitySlot[]
  memberships        TeamMembership[]
  notifications      Notification[]
  announcements      Announcement[]
  settings           TeamSettings?
  subscription       Subscription?
  users              User[]
}

/// Publiczny feed kalendarza iCal dla użytkownika (link do subskrypcji)
model CalendarFeed {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

/// Tokeny OAuth Google Calendar API — 1:1 z User
model GoogleCalendarToken {
  id              String   @id @default(uuid())
  userId          String   @unique
  accessToken     String
  refreshToken    String
  expiresAt       DateTime
  calendarId      String   @default("primary")
  lastSyncedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Subskrypcja zespołu (Stripe) — 1:1 z Team
model Subscription {
  id                   String    @id @default(uuid())
  teamId               String    @unique
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?
  planId               String    @default("free")
  status               String    @default("free")
  trialUsed            Boolean   @default(false)
  limitExceeded        Boolean   @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  team                 Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
}

/// Idempotencja webhooków Stripe
model StripeWebhookEvent {
  id           String   @id @default(uuid())
  stripeEventId String  @unique
  type         String
  processedAt  DateTime @default(now())
}

/// Ustawienia zespołu/firmy — 1:1 z Team
model TeamSettings {
  id                    String   @id @default(uuid())
  teamId                String   @unique
  companyName           String?
  logoUrl               String?
  defaultOpenHour       Int      @default(6)
  defaultCloseHour      Int      @default(22)
  minShiftDurationMin   Int      @default(240)
  maxShiftDurationMin   Int      @default(720)
  notifyShiftAssigned   Boolean  @default(true)
  notifyShiftPublished  Boolean  @default(true)
  notifyMarketplace     Boolean  @default(true)
  notifyAnnouncements   Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  team                  Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

/// Stanowiska zdefiniowane na poziomie zespołu (np. Kelner, Barista, Kucharz)
model Position {
  id        String             @id @default(uuid())
  teamId    String
  name      String
  color     String             @default("#8FACDB")
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employees EmployeePosition[]
  shifts    Shift[]

  @@unique([teamId, name])
  @@index([teamId])
}

/// Przypisanie pracownika do stanowiska (many-to-many)
model EmployeePosition {
  id         String   @id @default(uuid())
  userId     String
  positionId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([userId, positionId])
  @@index([userId])
  @@index([positionId])
}

/// Dostępność pracownika: przedział czasowy, w którym może pracować (min. 4h na slot).
model AvailabilitySlot {
  id           String   @id @default(uuid())
  userId       String
  teamId       String
  startDateTime DateTime
  endDateTime   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, startDateTime])
  @@index([teamId, startDateTime])
}

model Shift {
  id           String             @id @default(uuid())
  startTime    DateTime
  endTime      DateTime
  roleName     String
  positionId   String?
  status       ShiftStatus       @default(DRAFT)
  teamId       String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  team         Team             @relation(fields: [teamId], references: [id])
  position     Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  assignments  ShiftAssignment[]

  @@index([teamId, startTime])
}

/// Jedna "pozycja" na zmianie. Jedna zmiana może mieć wiele pozycji (kilku pracowników).
/// Giełda: isUpForGrabs = true — ktoś może przejąć to przypisanie (claim).
model ShiftAssignment {
  id           String   @id @default(uuid())
  shiftId      String
  userId       String?
  isUpForGrabs Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shift              Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([shiftId])
  @@index([userId])
  @@index([isUpForGrabs])
}

model TeamMembership {
  id          String           @id @default(uuid())
  userId      String
  teamId      String
  status      MembershipStatus @default(PENDING)
  role        Role             @default(EMPLOYEE)
  requestedAt DateTime         @default(now())
  approvedAt  DateTime?
  approvedBy  String?
  team        Team             @relation(fields: [teamId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@unique([userId, teamId])
}

/// Ogłoszenia zespołowe (tworzą Owner/Manager, widoczne dla całego zespołu)
model Announcement {
  id        String             @id @default(uuid())
  teamId    String
  authorId  String
  title     String
  content   String
  priority  AnnouncementPriority @default(NORMAL)
  expiresAt DateTime?
  createdAt DateTime           @default(now())
  team      Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reads     AnnouncementRead[]

  @@index([teamId, createdAt])
}

/// Odczytanie ogłoszenia przez użytkownika
model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

/// Powiadomienia wewnętrzne w aplikacji
model Notification {
  id        String           @id @default(uuid())
  userId    String
  teamId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  meta      String?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([teamId])
}

enum NotificationType {
  SHIFT_ASSIGNED
  SHIFT_PUBLISHED
  SHIFT_DELETED
  SHIFT_ON_MARKETPLACE
  MEMBERSHIP_APPROVED
  ANNOUNCEMENT
}

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

enum ShiftStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REJECTED
  LEFT
}

enum UserStatus {
  ACTIVE
  UNCLAIMED
}
