# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/shiftapp

# Auth
JWT_SECRET=your-jwt-secret
# NEXTAUTH_SECRET=  # alternativa do JWT_SECRET

# Stripe (płatności)
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Ceny planów (price IDs z Stripe Dashboard)
# UWAGA: Produkty/ceny w Stripe NIE powinny mieć domyślnego trialu — trial tylko przez Checkout (14 dni raz na zespół)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_STARTER_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# Google Calendar API (sync)
# Można użyć tych samych credentials co do logowania Google (GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET z frontendu)
# lub osobne — wystarczy dodać scope calendar.events w Google Cloud Console.
# GOOGLE_CALENDAR_CLIENT_ID=xxx
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://app.staffer.pl/app/calendar-callback

# Frontend URL (produkcja)
FRONTEND_URL=https://app.staffer.pl

# Sentry – monitoring błędów (https://sentry.io)
# DSN z projektu staffer-backend w Sentry (Project Settings → Client Keys)
SENTRY_DSN=""
# Nazwa środowiska wysyłana do Sentry
SENTRY_ENVIRONMENT="production"
