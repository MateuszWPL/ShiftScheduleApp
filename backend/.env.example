# ============================================================
# Staffer.pl Backend — Zmienne srodowiskowe
# ============================================================
# Skopiuj ten plik jako .env i uzupelnij wartosci.
# Zmienne oznaczone [WYMAGANE] sa obowiazkowe w produkcji.

# ── Baza danych ──────────────────────────────────────────────
# [WYMAGANE] Connection string do PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/shiftapp

# ── Autentykacja ─────────────────────────────────────────────
# [WYMAGANE] Secret do podpisywania tokenow JWT (min. 32 znaki)
JWT_SECRET=your-jwt-secret-min-32-characters
# Alternatywa — NextAuth secret (jesli uzywasz NextAuth na backendzie)
# NEXTAUTH_SECRET=

# ── Frontend URL ─────────────────────────────────────────────
# [WYMAGANE w produkcji] Adres frontendu — uzywany w emailach, CORS, Stripe redirect
# W dev nie jest wymagany (fallback na localhost:3000)
FRONTEND_URL=https://app.staffer.pl

# ── Stripe (platnosci) ──────────────────────────────────────
# [WYMAGANE do platnosci] Klucze API Stripe
# Sandbox: sk_test_... / whsec_test_...
# Produkcja: sk_live_... / whsec_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Ceny planow (Price ID z Stripe Dashboard → Products)
# UWAGA: Produkty w Stripe NIE powinny miec domyslnego trialu
# Trial jest kontrolowany przez Checkout session (14 dni, jednorazowo na zespol)
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_STARTER_YEARLY=price_xxx
STRIPE_PRICE_BUSINESS=price_xxx
STRIPE_PRICE_BUSINESS_YEARLY=price_xxx

# ── Email (Resend) ──────────────────────────────────────────
# [WYMAGANE] API key z https://resend.com/api-keys
RESEND_API_KEY=re_...
# Adres nadawcy (musi byc zweryfikowana domena w Resend)
RESEND_FROM=Staffer.pl <no-reply@staffer.pl>

# ── Pliki / Avatary (Cloudinary) ────────────────────────────
# [WYMAGANE w produkcji] Dane z https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email logo ───────────────────────────────────────────────
# URL logo wyswietlanego w naglowku emaili transakcyjnych
# Zalecane: self-hosted lub Cloudinary (160x48px)
EMAIL_LOGO_URL=https://your-domain.com/logo-email.png

# ── Google Calendar API (synchronizacja) ─────────────────────
# Mozna uzyc tych samych credentials co do Google OAuth (logowanie)
# lub osobne — wystarczy dodac scope calendar.events w Google Cloud Console
# GOOGLE_CALENDAR_CLIENT_ID=xxx
# GOOGLE_CALENDAR_CLIENT_SECRET=xxx
# GOOGLE_CALENDAR_REDIRECT_URI=https://app.staffer.pl/app/calendar-callback

# ── Sentry (monitoring bledow) ──────────────────────────────
# DSN z projektu staffer-backend w Sentry (Project Settings → Client Keys)
SENTRY_DSN=
# Nazwa srodowiska: production / staging / development
SENTRY_ENVIRONMENT=production

# ── Serwer ───────────────────────────────────────────────────
# Port na ktorym nasluchuje backend (domyslnie 3001)
# PORT=3001
# Srodowisko: production / development
# NODE_ENV=production
